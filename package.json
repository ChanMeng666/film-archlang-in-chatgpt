{
  "name": "film-archlang-in-chatgpt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A promo film of ArchLang in ChatGPT: a coded replica of the real pages, driven by a pure function of time.",
  "scripts": {
    "bake": "node scripts/bake.mjs",
    "plate": "node scripts/capture-3d.mjs",
    "cues": "tsx scripts/dump-cues.ts",
    "audio": "python audio/score.py",
    "gates": "tsx scripts/gates.ts",
    "studio": "remotion studio src/index.ts",
    "still": "remotion still src/index.ts film",
    "render": "remotion render src/index.ts film out/archlang-in-chatgpt.mp4 --crf=16 --audio-codec=aac --audio-bitrate=320k"
  },
  "dependencies": {
    "@remotion/cli": "4.0.522",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.522"
  },
  "devDependencies": {
    "@chanmeng666/archlang": "1.50.0",
    "@types/node": "^22.20.5",
    "@types/react": "19.2.7",
    "playwright": "1.56.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
